# Vite browser settings: public values only. This optional API must be a server you control.
VITE_APP_URL=https://backstop-xrpl.vercel.app
VITE_API_BASE_URL=
VITE_XRPL_EVM_CHAIN_ID=1449000
# Public contract addresses alone do not create a verified opportunity/facility binding.
VITE_LOAN_CONTRACT_ADDRESS=
VITE_PAYMENT_TOKEN_ADDRESS=

# Reserved SERVER configuration; never prefix credentials or private RPC URLs with VITE_.
DATABASE_URL=
AWS_REGION=
AWS_AGENTCORE_RUNTIME_ARN=
AWS_BEDROCK_MODEL_ID=
AP4M_API_URL=https://hackathon.ap4m.build
AP4M_AGENT_WALLET_ADDRESS=
AP4M_MERCHANT_WALLET_ADDRESS=

QUICKNODE_RPC_URL=
XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org
XRPL_EVM_CHAIN_ID=1449000
DEPLOYER_PRIVATE_KEY=
SENIOR_WALLET=
JUNIOR_WALLET_1=
JUNIOR_WALLET_2=
FEE_WALLET=
# The local contract demo uses mintable mock USD, not authentic RLUSD.

# Backend and durable storage
API_PORT=3001
APP_BASE_URL=http://127.0.0.1:3001
DATABASE_AUTH_TOKEN=
SESSION_SECRET=
BACKSTOP_OPERATOR_TOKEN=
BACKSTOP_OFFLINE=false
AWS_PROFILE=backstop
AWS_AGENTCORE_HARNESS_ARN=
# Verified model override for the existing Harness (no new Harness).
# AWS_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Stateful AP4M worker. Keep its state on a persistent host, outside Vercel temp storage.
AP4M_TEAM_NAME=Just Create Something
AP4M_MERCHANT_ID=
AP4M_WORKER_URL=http://127.0.0.1:4239
AP4M_WORKER_TOKEN=
# Optional fresh designated testnet signer only; interactive wallet is supported without a key.
AGENT_PRIVATE_KEY=
