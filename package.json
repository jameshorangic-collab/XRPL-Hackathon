{
  "name": "backstop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "contracts:test": "hardhat test",
    "contracts:compile": "hardhat compile && node scripts/export-artifacts.cjs",
    "chain": "hardhat node --hostname 127.0.0.1",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --network xrplTestnet",
    "verify:tx": "node --env-file-if-exists=.env scripts/verify-transaction.mjs",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write src scripts test *.cjs *.js *.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "hardhat": "^2.22.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
